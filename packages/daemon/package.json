{
  "name": "@memfold/daemon",
  "version": "0.1.0",
  "description": "Local-first memfold daemon: a REST/HTTP API plus git-backed append-only sync over the canonical store.",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "memfold-daemon": "./dist/bin.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@memfold/core": "workspace:*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "engines": { "node": ">=20.10.0" }
}
